NODE_ENV=development
PORT=5000

# Postgres (Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/auth_db"

# Redis (sessions + BullMQ)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-16-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-16-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Email verification
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN_MIN=60

# SMTP (used by the background email worker). Leave blank in dev to log emails to the console instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Auth Assignment <no-reply@example.com>"

FRONTEND_URL="http://localhost:3000"

# File upload (avatar)
MAX_AVATAR_SIZE_MB=2
UPLOAD_DIR=uploads

COOKIE_DOMAIN=
